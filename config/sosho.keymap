// 船長版 So-Sho keymap v1.5
// 目標：保留 QWERTY 肌肉記憶，把 NAV / SYM / SYS 重新分工。
// 適用：右手 Trackball + 左手 Trackpad
// v1.5：Mouse combo 55 ms；NAV 層下右手 Trackball 改為 Scroll mode。

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#define L_BASE 0
#define L_NAV  1
#define L_SYM  2
#define L_SYS  3

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

/ {
    behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };

        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

// Encoder scroll: no acceleration.
&msc {
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

// NAV layer: turn the right-hand trackball into a scroll wheel.
// The layer-specific override replaces the base listener processor list,
// so keep the stock X/Y inversion here before mapping XY -> wheel/HWheel.
// Start at 1/4 speed; tune after real use if it feels too fast/slow.
&trackball_listener {
    nav_scroll {
        layers = <L_NAV>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &zip_xy_to_scroll_mapper
            &zip_scroll_scaler 1 4
        >;
    };
};


/ {
    macros {
        // X + C + V = double left click.
        // Keep the two clicks far enough apart to be reliably observed by the host.
        dblclk: dblclk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <60>;
            tap-ms = <30>;
            bindings = <&mkp LCLK &mkp LCLK>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // Mouse clicks moved to the left hand so the right hand can stay on the trackball.
        // v1.5 uses a 55 ms window for the whole X/C/V mouse-combo family.
        // X + C = Left click (left adjacent pair)
        combo_LCLK {
            timeout-ms = <55>;
            key-positions = <26 27>;
            bindings = <&mkp LCLK>;
            layers = <L_BASE>;
        };

        // C + V = Right click (right adjacent pair)
        combo_RCLK {
            timeout-ms = <55>;
            key-positions = <27 28>;
            bindings = <&mkp RCLK>;
            layers = <L_BASE>;
        };

        // X + V = Middle click (ring + index fingers)
        combo_MCLK {
            timeout-ms = <55>;
            key-positions = <26 28>;
            bindings = <&mkp MCLK>;
            layers = <L_BASE>;
        };

        // X + C + V = double left click.
        // This intentionally overlaps X+C (left click) and C+V (right click);
        // v1.4 is an A/B test of ZMK's fully-overlapping combo handling.
        combo_DBLCLK {
            timeout-ms = <55>;
            key-positions = <26 27 28>;
            bindings = <&dblclk>;
            layers = <L_BASE>;
        };

        // D + F = momentary NAV.
        // slow-release: after triggering with D+F, NAV remains active
        // until both combo keys are released.
        combo_NAV {
            timeout-ms = <40>;
            key-positions = <15 16>;
            bindings = <&mo L_NAV>;
            layers = <L_BASE>;
            slow-release;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * BASE
         *
         *  TAB    Q    W    E    R    T   |   Y    U    I    O    P   BSPC
         *  CTRL   A    S    D    F    G   |   H    J    K    L    ;   ENTER
         *  SHIFT  Z    X    C    V    B   |   N    M    ,    .    /   RSHIFT
         *  ESC   ALT       SPACE ----     |   DEL  SYM       SYS   GUI
         *
         * 與官方版相比：
         * - ; 回到 Base，對 C/C++ 比 ' 實用。
         * - Backspace 回到右上角；Delete 移到右拇指。
         * - Space 留在較順手的左拇指位置。
         * - 拇指 NAV 取消，改用左手 D+F combo 進入 NAV。
         * - SYM 由右拇指啟動，常用程式符號集中在左手。
         */
        default_layer {
            bindings = <
                &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y       &kp U     &kp I      &kp O      &kp P       &kp BSPC
                &kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G        &kp H       &kp J     &kp K      &kp L      &kp SEMI    &kp ENTER
                &kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B        &kp N       &kp M     &kp COMMA  &kp DOT    &kp SLASH   &kp RSHFT
                &kp ESC    &kp LALT              &kp SPACE &none                &kp DEL      &mo L_SYM                &mo L_SYS &kp LGUI
            >;

            sensor-bindings = <
                &ec_ms_l SCRL_LEFT SCRL_RIGHT
                &ec_ms_r SCRL_DOWN SCRL_UP
            >;
        };

        /*
         * NAV
         * 左手 D+F combo 觸發 NAV，右手負責導航。
         * combo 使用 slow-release，可先 D+F 觸發，再只留其中一指壓住。
         *
         *  ----   ---- ---- ---- ---- ---- | PgUp  Home   Up    End   PgDn  Del
         *  ----   ---- ---- ---- ---- ---- | Ctrl← Left  Down  Right Ctrl→  ----
         *  ----   ---- ---- ---- ---- ---- | Undo  Cut   Copy  Paste Redo   ----
         *  ----   ----      ---- ----      | ----  ----      ----  ----
         */
        nav_layer {
            bindings = <
                &trans      &trans       &trans       &trans       &trans       &trans        &kp PG_UP    &kp HOME      &kp UP        &kp END       &kp PG_DN     &kp DEL
                &trans      &trans       &trans       &trans       &trans       &trans        &kp LC(LEFT) &kp LEFT      &kp DOWN      &kp RIGHT     &kp LC(RIGHT) &trans
                &trans      &trans       &trans       &trans       &trans       &trans        &kp LC(Z)    &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(Y)     &trans
                &trans      &trans                    &trans       &trans                     &trans        &trans                      &trans          &trans
            >;
        };

        /*
         * SYM
         * 右拇指按住 SYM。
         *
         *  `      1    2    3    4    5   |   6    7    8    9    0     =
         *  ----   (    )    [    ]    \\   |   -    =    ;    '    &     ^
         *  ----   {    }    <    >    |   |   _    +    :    \"    ?     ~
         *  ----   ----      ---- ----      | ----  ----      ----  ----
         *
         * 括號與 delimiter 全放左手，右手只負責壓住 SYM。
         */
        sym_layer {
            bindings = <
                &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6     &kp N7     &kp N8     &kp N9     &kp N0      &kp EQUAL
                &trans     &kp LPAR  &kp RPAR  &kp LBKT  &kp RBKT  &kp BSLH     &kp MINUS  &kp EQUAL  &kp SEMI   &kp SQT    &kp AMPS    &kp CARET
                &trans     &kp LBRC  &kp RBRC  &kp LT    &kp GT    &kp PIPE     &kp UNDER  &kp PLUS   &kp COLON  &kp DQT    &kp QMARK   &kp TILDE
                &trans     &trans                &trans    &trans                 &trans      &trans                  &trans       &trans
            >;
        };

        /*
         * SYS
         * 低頻功能全部趕到這一層。
         *
         *  F1     F2   F3   F4   F5   F6  | F7    F8    F9    F10   F11   F12
         *  Prev   Vol- Vol+ Mute Play Next | BT0   BT1   BT2   BT3   BT4   BT_CLR
         *  PrtSc  Ins  Del  ---- USB  BLE  | BT←   BT→   ----  ---- CLRALL ----
         *  ----   ----      ---- ----      | ----  ----       ---- ----
         */
        sys_layer {
            bindings = <
                &kp F1       &kp F2        &kp F3        &kp F4        &kp F5        &kp F6          &kp F7         &kp F8         &kp F9         &kp F10         &kp F11        &kp F12
                &kp C_PREV   &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE   &kp C_PP      &kp C_NEXT      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4   &bt BT_CLR
                &kp PSCRN    &kp INS        &kp DEL       &trans        &out OUT_USB   &out OUT_BLE     &bt BT_PRV     &bt BT_NXT     &trans          &trans           &bt BT_CLR_ALL &trans
                &trans       &trans                        &trans        &trans                         &trans           &trans                           &trans          &trans
            >;

            // Left encoder becomes volume on SYS; right encoder keeps vertical scroll.
            sensor-bindings = <
                &inc_dec_kp C_VOL_DN C_VOL_UP
                &ec_ms_r SCRL_DOWN SCRL_UP
            >;
        };

        // Keep two reserved layers for later ZMK Studio experiments.
        scroll {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };
    };
};
